# Copy to .env and edit before `docker compose up`.
# SITE_URL / WARMUP_TOKEN / TARGET_DIR are applied to /data/config/config.sh
# and /data/config/mt_proxy_config.php on FIRST start only; afterwards edit
# those files inside the volume (docker compose exec mirror ...).

TZ=UTC

# Base URL the sync loop uses to call the warm-up endpoint.
# For the named-volume default setup http://localhost is fine.
SITE_URL=http://localhost

# REQUIRED. Secret for /routeros/ros-warmup.php; must be the same in
# scripts/config.sh and mt_proxy_config.php (the entrypoint injects it
# into both on first run).
# pwgen 20 1
WARMUP_TOKEN=change-me-to-a-random-secret

# Web admin panel (Basic Auth at /mt-proxy/). If ADMIN_PASSWORD is empty,
# a password is generated once and printed to the container log.
ADMIN_USER=admin
ADMIN_PASSWORD=
# or use predefined hash
# ADMIN_PASSWORD_HASH='set-predefined-hash'

# Mirroring schedule
SYNC_INTERVAL_HOURS=3
SYNC_START_DELAY=90

# --- LDAP auth for the admin UI (optional) ---------------------------------
# MT_LDAP_AUTH=1 switches the Basic Auth backend of /mt-proxy/ from the
# .htpasswd file to LDAP lookups (mod_authn_ldap). The .htpasswd file is
# still seeded and kept as a fallback; set MT_LDAP_AUTH=0 (or remove the
# MT_LDAP_* variables) to go back to it.
# Required when MT_LDAP_AUTH=1: MT_LDAP_URL and MT_LDAP_BASE_DN.
#MT_LDAP_AUTH=0
# Active Directory example:
#   MT_LDAP_URL=ldaps://dc01.example.com:636
#   MT_LDAP_BASE_DN=DC=example,DC=com
#   MT_LDAP_BIND_DN=CN=svc-mikrotik,OU=service-accounts,DC=example,DC=com
#   MT_LDAP_BIND_PASSWORD=svc-account-password
#   MT_LDAP_FILTER=(&(sAMAccountName=?)(memberOf=CN=mikrotik-admins,OU=groups,DC=example,DC=com))
# OpenLDAP example:
#   MT_LDAP_URL=ldap://ldap.corp.example.com:389
#   MT_LDAP_BASE_DN=ou=people,DC=corp,DC=example,DC=com
#   MT_LDAP_BIND_DN=cn=svc-mikrotik,ou=service-accounts,DC=corp,DC=example,DC=com
#   MT_LDAP_BIND_PASSWORD=svc-account-password
#   MT_LDAP_FILTER=(uid=?)
#   MT_LDAP_STARTTLS=1
# For self-signed ldaps:// / STARTTLS mount the CA certificate into the
# container (e.g. into /data/config/) and point the config at it:
#MT_LDAP_CA_CERT=/data/config/ldap-ca.pem
#   (goes to both lighttpd (auth.backend.ldap.ca-file) and /etc/ldap/ldap.conf
#   (TLS_CACERT); libldap additionally honours the LDAPTLS_CACERT env var)
# For DCs with self-signed certificates you can also disable the TLS server
# certificate verification entirely (MITM risk on the directory connection):
#MT_LDAP_TLS_REQCERT=never
#   allowed: never|allow|try|demand|hard; unset = libldap default (demand).
#   The entrypoint regenerates /etc/ldap/ldap.conf on every start; to manage
#   it by hand instead, put your own file at /data/config/ldap.conf — it wins.
#MT_LDAP_URL=ldap://ldap.example.com:389
#MT_LDAP_BASE_DN='OU=Users,DC=example,DC=com'
#MT_LDAP_BIND_DN='cn=svc-mikrotik,ou=service-accounts,dc=example,dc=com'
#MT_LDAP_BIND_PASSWORD='password'
#MT_LDAP_FILTER='(cn=?)'
#MT_LDAP_REQUIRE_GROUP='cn=mikrotik-admins,ou=Groups,dc=example,dc=com'
## MT_LDAP_GROUP_MEMBER='memberUid'   # только для posixGroup; member — дефолт
