# Copy to .env and edit before `docker compose up`.
# SITE_URL / WARMUP_TOKEN / TARGET_DIR are applied to /data/config/config.sh
# and /data/config/mt_proxy_config.php on FIRST start only; afterwards edit
# those files inside the volume (docker compose exec mirror ...).

TZ=UTC

# Base URL the sync loop uses to call the warm-up endpoint.
# For the named-volume default setup http://localhost is fine.
SITE_URL=http://localhost

# REQUIRED. Secret for /routeros/ros-warmup.php; must be the same in
# scripts/config.sh and mt_proxy_config.php (the entrypoint injects it
# into both on first run).
# pwgen 20 1
WARMUP_TOKEN=change-me-to-a-random-secret

# Web admin panel (Basic Auth at /mt-proxy/). If ADMIN_PASSWORD is empty,
# a password is generated once and printed to the container log.
ADMIN_USER=admin
ADMIN_PASSWORD=
# or use predefined hash
# ADMIN_PASSWORD_HASH='set-predefined-hash'

# Mirroring schedule
SYNC_INTERVAL_HOURS=3
SYNC_START_DELAY=90
