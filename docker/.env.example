# mikrotik-local-repo — docker compose environment
#
# Copy to .env and edit:   cp .env.example .env
# Compose reads .env from the directory of compose.yaml (docker/).
# Every variable has a sane default except WARMUP_TOKEN, which is required.

# --- Core ---------------------------------------------------------------
# Address devices use to reach the mirror (embedded into the *.rsc scripts).
# Static DNS on the routers: download.mikrotik.com / upgrade.mikrotik.com
# -> the IP of this host. Examples: http://mirror.lan, http://10.0.0.5,
#    http://mirror.lan:8080 (only http:// is expected here).
SITE_URL=http://mirror.lan

# Token for /routeros/ros-warmup.php (cache warming) and the sync loop.
# Allowed characters: letters, digits, '_', '-' (validated on container
# start; '|' or '&' would corrupt the generated configs). Generate one:
#   pwgen 20 1
WARMUP_TOKEN=change-me-to-a-random-secret

# --- Admin UI (Basic Auth on /mt-proxy/) ---------------------------------
ADMIN_USER=admin
# Empty -> a random password is generated ONCE and printed to docker logs.
ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: a ready htpasswd hash instead of a plain
# password (e.g. the output of:  openssl passwd -apr1 'password').
ADMIN_PASSWORD_HASH=

# --- State directory on the host ------------------------------------------
# Everything persistent lives here: routeros/ (mirror), state/ (SQLite DB),
# config/ (config.sh, .htpasswd, ldap.conf, CA pem). Relative paths resolve
# against docker/. Backup = stop the stack and copy this directory.
MIRROR_DATA_DIR=./data

# --- Sync loop (replaces cron) ---------------------------------------------
SYNC_INTERVAL_HOURS=3
# Delay before the very first sync after container start, seconds.
SYNC_START_DELAY=90

# --- LDAP auth for the admin UI (optional, replaces .htpasswd) -------------
# Full reference: the "LDAP-авторизация админки" section of docker/README.md.
#MT_LDAP_AUTH=1
#MT_LDAP_URL=ldaps://dc01.corp.example.com:636
#MT_LDAP_BASE_DN=DC=corp,DC=example,DC=com
#MT_LDAP_BIND_DN=CN=svc-mikrotik,OU=service-accounts,DC=corp,DC=example,DC=com
#MT_LDAP_BIND_PASSWORD=svc-account-password
# '?' = the login placeholder lighttpd substitutes (LDAP-escaped).
# AD example:  (&(sAMAccountName=?)(memberOf=CN=mikrotik-admins,OU=groups,DC=corp,DC=example,DC=com))
# OpenLDAP default: (uid=?)
#MT_LDAP_FILTER=(&(sAMAccountName=?)(memberOf=CN=mikrotik-admins,OU=groups,DC=corp,DC=example,DC=com))
# Restrict the UI to group members (checked natively by mod_authn_ldap):
# a group DN, or several joined with '|'. Leave unset for valid-user.
#MT_LDAP_REQUIRE_GROUP=CN=mikrotik-admins,OU=groups,DC=corp,DC=example,DC=com
# Membership attribute: "member" = compare with the user DN
# (groupOfNames/groupOfUniqueNames); "memberUid" = posixGroup login.
#MT_LDAP_GROUP_MEMBER=member
#MT_LDAP_STARTTLS=0
# CA certificate path INSIDE the container for self-signed ldaps/STARTTLS,
# e.g. /data/config/ldap-ca.pem (mounted via MIRROR_DATA_DIR/config/).
#MT_LDAP_CA_CERT=
# libldap server-cert verification: never|allow|try|demand|hard.
# 'never' is the typical choice for a self-signed DC certificate (a WARNING
# is logged); prefer MT_LDAP_CA_CERT with the default demand in production.
#MT_LDAP_TLS_REQCERT=
